<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
	<item>
		<layer-list>
			<item>
				<shape android:shape="rectangle">
					<solid android:color="@color/glass_fill" />
					<stroke android:width="0.5dp" android:color="@color/glass_edge" />
					<corners android:radius="999dp" />
				</shape>
			</item>
			<item
				android:bottom="1dp"
				android:left="1dp"
				android:right="1dp"
				android:top="1dp">
				<shape android:shape="rectangle">
					<stroke android:width="1dp" android:color="@color/glass_stroke" />
					<corners android:radius="999dp" />
				</shape>
			</item>
			<item
				android:height="20dp"
				android:gravity="top"
				android:left="6dp"
				android:right="6dp"
				android:top="2dp">
				<shape android:shape="rectangle">
					<gradient
						android:angle="270"
						android:endColor="#00FFFFFF"
						android:startColor="@color/glass_highlight" />
					<corners android:radius="999dp" />
				</shape>
			</item>
		</layer-list>
	</item>
</ripple>
