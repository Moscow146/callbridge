<resources>
	<style name="Theme.CallBridge" parent="android:Theme.Material.Light.NoActionBar">
		<item name="android:windowBackground">@color/bg_grouped</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@android:color/transparent</item>
		<item name="android:windowLightStatusBar">true</item>
		<item name="android:windowLightNavigationBar">true</item>
		<item name="android:colorAccent">@color/accent</item>
	</style>

	<style name="Text.Title" parent="">
		<item name="android:textColor">@color/label</item>
		<item name="android:textSize">28sp</item>
		<item name="android:lineHeight">34sp</item>
		<item name="android:textStyle">bold</item>
	</style>

	<style name="Text.Body" parent="">
		<item name="android:textColor">@color/label</item>
		<item name="android:textSize">17sp</item>
		<item name="android:lineHeight">22sp</item>
	</style>

	<style name="Text.Subhead" parent="">
		<item name="android:textColor">@color/label_secondary</item>
		<item name="android:textSize">15sp</item>
		<item name="android:lineHeight">20sp</item>
	</style>

	<style name="Text.Footnote" parent="">
		<item name="android:textColor">@color/label_secondary</item>
		<item name="android:textSize">13sp</item>
		<item name="android:lineHeight">18sp</item>
	</style>

	<style name="Button.Capsule" parent="">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:minHeight">50dp</item>
		<item name="android:paddingHorizontal">20dp</item>
		<item name="android:paddingVertical">12dp</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="android:stateListAnimator">@null</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">17sp</item>
	</style>

	<style name="Section" parent="">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:background">@drawable/bg_section</item>
		<item name="android:clipToOutline">true</item>
		<item name="android:orientation">vertical</item>
	</style>

	<style name="Row" parent="">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:background">@drawable/bg_row</item>
		<item name="android:clickable">true</item>
		<item name="android:focusable">true</item>
		<item name="android:gravity">center_vertical</item>
		<item name="android:minHeight">48dp</item>
		<item name="android:orientation">horizontal</item>
		<item name="android:paddingHorizontal">16dp</item>
		<item name="android:paddingVertical">11dp</item>
	</style>

	<style name="Chevron" parent="">
		<item name="android:layout_width">20dp</item>
		<item name="android:layout_height">20dp</item>
		<item name="android:layout_marginStart">8dp</item>
		<item name="android:importantForAccessibility">no</item>
		<item name="android:src">@drawable/ic_chevron</item>
		<item name="android:tint">@color/label_secondary</item>
	</style>
</resources>
