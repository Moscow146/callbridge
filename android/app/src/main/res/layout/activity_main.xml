<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_main">

	<FrameLayout
		android:id="@+id/orbs"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipChildren="false">

		<View
			android:id="@+id/orb_blue"
			android:layout_width="320dp"
			android:layout_height="320dp"
			android:layout_marginStart="-120dp"
			android:layout_marginTop="-60dp"
			android:background="@drawable/orb_blue" />

		<View
			android:id="@+id/orb_pink"
			android:layout_width="300dp"
			android:layout_height="300dp"
			android:layout_gravity="end|center_vertical"
			android:layout_marginEnd="-140dp"
			android:background="@drawable/orb_pink" />

		<View
			android:id="@+id/orb_teal"
			android:layout_width="280dp"
			android:layout_height="280dp"
			android:layout_gravity="bottom"
			android:layout_marginStart="-60dp"
			android:layout_marginBottom="-100dp"
			android:background="@drawable/orb_teal" />
	</FrameLayout>

	<LinearLayout
		android:id="@+id/content"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:padding="22dp">

		<FrameLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:layout_marginBottom="22dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:fontFamily="sans-serif-medium"
				android:text="@string/app_name"
				android:textColor="#F5F7FF"
				android:textSize="32sp" />

			<TextView
				android:id="@+id/pill"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="end|center_vertical"
				android:background="@drawable/pill_status"
				android:fontFamily="sans-serif-medium"
				android:paddingHorizontal="14dp"
				android:paddingVertical="8dp"
				android:text="Offline"
				android:textColor="#F5F7FF"
				android:textSize="12sp" />
		</FrameLayout>

		<dev.callbridge.GlassLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="24dp">

			<TextView
				android:id="@+id/pc_name"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:fontFamily="sans-serif-medium"
				android:textColor="#F5F7FF"
				android:textSize="24sp" />

			<TextView
				android:id="@+id/status"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:textColor="#B8F5F7FF"
				android:textSize="14sp" />

			<Button
				android:id="@+id/toggle"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:layout_marginTop="24dp"
				android:background="@drawable/btn_green"
				android:fontFamily="sans-serif-medium"
				android:stateListAnimator="@null"
				android:text="@string/connect"
				android:textAllCaps="false"
				android:textColor="#FFFFFF"
				android:textSize="16sp" />

			<Button
				android:id="@+id/scan"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:layout_marginTop="12dp"
				android:background="@drawable/btn_glass"
				android:fontFamily="sans-serif-medium"
				android:stateListAnimator="@null"
				android:text="@string/scan_qr"
				android:textAllCaps="false"
				android:textColor="#F5F7FF"
				android:textSize="16sp" />
		</dev.callbridge.GlassLayout>
	</LinearLayout>
</FrameLayout>
