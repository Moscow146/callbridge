<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/bg_grouped">

	<ScrollView
		android:id="@+id/scroll"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:fillViewport="true">

	<LinearLayout
		android:id="@+id/content"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal"
		android:orientation="vertical"
		android:paddingHorizontal="20dp">

		<FrameLayout
			android:id="@+id/status_badge"
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:layout_marginTop="24dp"
			android:background="@drawable/bg_circle">

			<ImageView
				android:id="@+id/status_icon"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:layout_gravity="center"
				android:importantForAccessibility="no"
				android:tint="@color/on_fill" />
		</FrameLayout>

		<TextView
			android:id="@+id/title"
			style="@style/Text.Title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:accessibilityHeading="true"
			android:accessibilityLiveRegion="polite"
			android:gravity="center" />

		<TextView
			android:id="@+id/detail"
			style="@style/Text.Subhead"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:gravity="center" />

		<TextView
			android:id="@+id/access_header"
			style="@style/Text.Footnote"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="32dp"
			android:layout_marginBottom="6dp"
			android:accessibilityHeading="true"
			android:paddingHorizontal="16dp"
			android:text="@string/access_header" />

		<LinearLayout
			android:id="@+id/access_section"
			style="@style/Section">

			<LinearLayout
				android:id="@+id/access_phone"
				style="@style/Row">

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Text.Body"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/access_phone" />

					<TextView
						style="@style/Text.Footnote"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="@string/access_phone_detail" />
				</LinearLayout>

				<ImageView style="@style/Chevron" />
			</LinearLayout>

			<View
				android:id="@+id/access_divider"
				android:layout_width="match_parent"
				android:layout_height="1px"
				android:layout_marginStart="16dp"
				android:background="@color/separator" />

			<LinearLayout
				android:id="@+id/access_overlay"
				style="@style/Row">

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Text.Body"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/access_overlay" />

					<TextView
						style="@style/Text.Footnote"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="@string/access_overlay_detail" />
				</LinearLayout>

				<ImageView style="@style/Chevron" />
			</LinearLayout>
		</LinearLayout>

		<LinearLayout
			android:id="@+id/pair_section"
			style="@style/Section"
			android:layout_marginTop="32dp">

			<LinearLayout
				android:id="@+id/pair_other"
				style="@style/Row">

				<TextView
					style="@style/Text.Body"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/pair_other" />

				<ImageView style="@style/Chevron" />
			</LinearLayout>
		</LinearLayout>

		<TextView
			android:id="@+id/footer"
			style="@style/Text.Footnote"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:paddingHorizontal="16dp"
			android:text="@string/footer_modes" />
	</LinearLayout>
	</ScrollView>

	<dev.callbridge.GlassBar
		android:id="@+id/header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top">

		<TextView
			android:id="@+id/header_title"
			android:layout_width="match_parent"
			android:layout_height="44dp"
			android:accessibilityHeading="true"
			android:fontFamily="sans-serif-medium"
			android:gravity="center"
			android:text="@string/app_name"
			android:textColor="@color/label"
			android:textSize="17sp" />
	</dev.callbridge.GlassBar>

	<dev.callbridge.GlassBar
		android:id="@+id/bottom_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:paddingHorizontal="20dp"
		android:paddingTop="12dp">

		<Button
			android:id="@+id/primary"
			style="@style/Button.Capsule" />
	</dev.callbridge.GlassBar>
</FrameLayout>
