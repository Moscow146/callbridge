<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:sys="clr-namespace:System;assembly=System.Runtime">
	<SolidColorBrush x:Key="WindowBg" Color="#FFF2F2F7"/>
	<SolidColorBrush x:Key="Surface" Color="#FFFFFFFF"/>
	<SolidColorBrush x:Key="Raised" Color="#FFFFFFFF"/>
	<SolidColorBrush x:Key="Label" Color="#FF000000"/>
	<SolidColorBrush x:Key="LabelSecondary" Color="#FF5C5C63"/>
	<SolidColorBrush x:Key="Placeholder" Color="#FF68686E"/>
	<SolidColorBrush x:Key="Separator" Color="#FFD1D1D6"/>
	<SolidColorBrush x:Key="Fill" Color="#FFECECF1"/>
	<SolidColorBrush x:Key="FillHover" Color="#FFE3E3E9"/>
	<SolidColorBrush x:Key="FillPressed" Color="#FFD6D6DD"/>
	<SolidColorBrush x:Key="Selected" Color="#FF1E6EF4"/>
	<SolidColorBrush x:Key="OnSelected" Color="#FFFFFFFF"/>
	<SolidColorBrush x:Key="Accent" Color="#FF1E6EF4"/>
	<SolidColorBrush x:Key="OnFill" Color="#FFFFFFFF"/>
	<SolidColorBrush x:Key="GreenFill" Color="#FF008932"/>
	<SolidColorBrush x:Key="RedFill" Color="#FFE9152D"/>
	<SolidColorBrush x:Key="Green" Color="#FF008932"/>
	<SolidColorBrush x:Key="Red" Color="#FFD3102A"/>
	<SolidColorBrush x:Key="Orange" Color="#FFC55300"/>
	<SolidColorBrush x:Key="Thumb" Color="#FFFFFFFF"/>
	<SolidColorBrush x:Key="ThumbRim" Color="#FF9A9AA2"/>
	<SolidColorBrush x:Key="GlassBar" Color="#66FAFBFE"/>
	<sys:Double x:Key="GlassBlurOpacity">0.85</sys:Double>
	<SolidColorBrush x:Key="GlassSolid" Color="#FFF2F2F7"/>
	<SolidColorBrush x:Key="GlassRim" Color="#00000000"/>
	<LinearGradientBrush x:Key="GlassRimMica" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#F2FFFFFF" Offset="0"/>
		<GradientStop Color="#66FFFFFF" Offset="0.45"/>
		<GradientStop Color="#33707080" Offset="1"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="GlassSheen" Color="#00000000"/>
	<LinearGradientBrush x:Key="GlassSheenMica" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#B3FFFFFF" Offset="0"/>
		<GradientStop Color="#00FFFFFF" Offset="0.6"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="SectionEdge" Color="#00000000"/>
	<SolidColorBrush x:Key="SectionEdgeMica" Color="#00000000"/>
</ResourceDictionary>
