<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:sys="clr-namespace:System;assembly=System.Runtime">
	<SolidColorBrush x:Key="WindowBg" Color="{x:Static SystemColors.WindowColor}"/>
	<SolidColorBrush x:Key="Surface" Color="{x:Static SystemColors.WindowColor}"/>
	<SolidColorBrush x:Key="Raised" Color="{x:Static SystemColors.WindowColor}"/>
	<SolidColorBrush x:Key="Label" Color="{x:Static SystemColors.WindowTextColor}"/>
	<SolidColorBrush x:Key="LabelSecondary" Color="{x:Static SystemColors.WindowTextColor}"/>
	<SolidColorBrush x:Key="Placeholder" Color="{x:Static SystemColors.GrayTextColor}"/>
	<SolidColorBrush x:Key="Separator" Color="{x:Static SystemColors.WindowTextColor}"/>
	<SolidColorBrush x:Key="Fill" Color="{x:Static SystemColors.ControlColor}"/>
	<SolidColorBrush x:Key="FillHover" Color="{x:Static SystemColors.HighlightColor}"/>
	<SolidColorBrush x:Key="FillPressed" Color="{x:Static SystemColors.HighlightColor}"/>
	<SolidColorBrush x:Key="Selected" Color="{x:Static SystemColors.HighlightColor}"/>
	<SolidColorBrush x:Key="OnSelected" Color="{x:Static SystemColors.HighlightTextColor}"/>
	<SolidColorBrush x:Key="Accent" Color="{x:Static SystemColors.HighlightColor}"/>
	<SolidColorBrush x:Key="OnFill" Color="{x:Static SystemColors.HighlightTextColor}"/>
	<SolidColorBrush x:Key="GreenFill" Color="{x:Static SystemColors.HighlightColor}"/>
	<SolidColorBrush x:Key="RedFill" Color="{x:Static SystemColors.HighlightColor}"/>
	<SolidColorBrush x:Key="Green" Color="{x:Static SystemColors.WindowTextColor}"/>
	<SolidColorBrush x:Key="Red" Color="{x:Static SystemColors.WindowTextColor}"/>
	<SolidColorBrush x:Key="Orange" Color="{x:Static SystemColors.WindowTextColor}"/>
	<SolidColorBrush x:Key="Thumb" Color="{x:Static SystemColors.WindowTextColor}"/>
	<SolidColorBrush x:Key="ThumbRim" Color="{x:Static SystemColors.WindowTextColor}"/>
	<SolidColorBrush x:Key="GlassBar" Color="{x:Static SystemColors.WindowColor}"/>
	<sys:Double x:Key="GlassBlurOpacity">0</sys:Double>
	<SolidColorBrush x:Key="GlassSolid" Color="{x:Static SystemColors.WindowColor}"/>
	<SolidColorBrush x:Key="GlassRim" Color="#00000000"/>
	<SolidColorBrush x:Key="GlassRimMica" Color="#00000000"/>
	<SolidColorBrush x:Key="GlassSheen" Color="#00000000"/>
	<SolidColorBrush x:Key="GlassSheenMica" Color="#00000000"/>
	<SolidColorBrush x:Key="SectionEdge" Color="{x:Static SystemColors.WindowTextColor}"/>
	<SolidColorBrush x:Key="SectionEdgeMica" Color="{x:Static SystemColors.WindowTextColor}"/>
</ResourceDictionary>
