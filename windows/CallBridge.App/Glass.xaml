<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:local="clr-namespace:CallBridge.App">

	<local:PillRadiusConverter x:Key="Pill"/>

	<FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
	<FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

	<SolidColorBrush x:Key="TextPrimary" Color="#FFF5F7FF"/>
	<SolidColorBrush x:Key="TextSecondary" Color="#B8F5F7FF"/>
	<SolidColorBrush x:Key="Green" Color="#FF30D158"/>
	<SolidColorBrush x:Key="Red" Color="#FFFF453A"/>
	<SolidColorBrush x:Key="Amber" Color="#FFFF9F0A"/>

	<LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Color="#3DFFFFFF" Offset="0"/>
		<GradientStop Color="#14FFFFFF" Offset="0.55"/>
		<GradientStop Color="#1FFFFFFF" Offset="1"/>
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Color="#B3FFFFFF" Offset="0"/>
		<GradientStop Color="#1FFFFFFF" Offset="0.35"/>
		<GradientStop Color="#0FFFFFFF" Offset="0.65"/>
		<GradientStop Color="#66FFFFFF" Offset="1"/>
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="GreenFill" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#FF4CE07A" Offset="0"/>
		<GradientStop Color="#FF28B94B" Offset="1"/>
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="RedFill" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#FFFF6A60" Offset="0"/>
		<GradientStop Color="#FFE5352B" Offset="1"/>
	</LinearGradientBrush>

	<DropShadowEffect x:Key="CardShadow" BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.35" Color="#FF000000"/>
	<DropShadowEffect x:Key="SoftShadow" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.3" Color="#FF000000"/>

	<Style x:Key="Card" TargetType="Border">
		<Setter Property="CornerRadius" Value="30"/>
		<Setter Property="Padding" Value="20"/>
		<Setter Property="Margin" Value="0,0,0,14"/>
		<Setter Property="Background" Value="{StaticResource GlassFill}"/>
		<Setter Property="BorderBrush" Value="{StaticResource GlassRim}"/>
		<Setter Property="BorderThickness" Value="1.2"/>
		<Setter Property="Effect" Value="{StaticResource CardShadow}"/>
	</Style>

	<Style x:Key="Caption" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Margin" Value="4,0,0,8"/>
	</Style>

	<Style x:Key="IconText" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
	</Style>

	<Style x:Key="GlassButton" TargetType="Button">
		<Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
		<Setter Property="Background" Value="#2EFFFFFF"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Padding" Value="20,11"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Bd" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Pill}}" Background="{TemplateBinding Background}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" Effect="{StaticResource SoftShadow}">
						<Grid>
							<Border x:Name="Overlay" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Pill}}" Background="#00FFFFFF"/>
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Overlay" Property="Background" Value="#2BFFFFFF"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Overlay" Property="Background" Value="#33000000"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.4"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
		<Setter Property="Width" Value="64"/>
		<Setter Property="Height" Value="64"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="FontSize" Value="24"/>
	</Style>

	<Style x:Key="GlassToggle" TargetType="ToggleButton">
		<Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Padding" Value="18,12"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Border x:Name="Bd" CornerRadius="22" Background="#2EFFFFFF" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" Effect="{StaticResource SoftShadow}">
						<Grid>
							<Border x:Name="Overlay" CornerRadius="22" Background="#00FFFFFF"/>
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Overlay" Property="Background" Value="#26FFFFFF"/>
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="#F2FFFFFF"/>
							<Setter Property="Foreground" Value="#FF111827"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="GlassTextBox" TargetType="TextBox">
		<Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
		<Setter Property="CaretBrush" Value="White"/>
		<Setter Property="SelectionBrush" Value="#80FFFFFF"/>
		<Setter Property="FontSize" Value="15"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Border CornerRadius="22" Background="#26FFFFFF" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" Height="44">
						<Grid>
							<TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="18,0" VerticalAlignment="Center" Foreground="#80F5F7FF"
									   IsHitTestVisible="False" Visibility="Collapsed"/>
							<ScrollViewer x:Name="PART_ContentHost" Margin="18,0" VerticalAlignment="Center"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="Text" Value="">
							<Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
		<Border x:Name="Bd" CornerRadius="22" Background="#2EFFFFFF" BorderBrush="{StaticResource GlassRim}" BorderThickness="1">
			<Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Data="M0,0 L5,5 L10,0"
				  Stroke="#CCFFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="GlassComboItem" TargetType="ComboBoxItem">
		<Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
		<Setter Property="Padding" Value="14,10"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBoxItem">
					<Border x:Name="Bd" CornerRadius="12" Margin="6,2" Background="Transparent" Padding="{TemplateBinding Padding}">
						<ContentPresenter/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="#47FFFFFF"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="GlassCombo" TargetType="ComboBox">
		<Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Height" Value="44"/>
		<Setter Property="ItemContainerStyle" Value="{StaticResource GlassComboItem}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBox">
					<Grid>
						<ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
									  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
						<ContentPresenter IsHitTestVisible="False" Margin="18,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Left"
										  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
						<Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
							<Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Margin="0,6,0,24" CornerRadius="22"
									Background="#F2161B30" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" Effect="{StaticResource CardShadow}">
								<ScrollViewer Margin="0,8" VerticalScrollBarVisibility="Hidden">
									<ItemsPresenter/>
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="SliderFill" TargetType="RepeatButton">
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RepeatButton">
					<Border Background="Transparent">
						<Border Height="6" CornerRadius="3" Background="#F2FFFFFF" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="SliderEmpty" TargetType="RepeatButton">
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RepeatButton">
					<Border Background="Transparent"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="SliderThumb" TargetType="Thumb">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Thumb">
					<Ellipse Width="26" Height="26" Fill="White" Stroke="#40FFFFFF" StrokeThickness="1" Effect="{StaticResource SoftShadow}"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="GlassSlider" TargetType="Slider">
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Slider">
					<Grid Height="30">
						<Border Height="6" CornerRadius="3" Background="#33FFFFFF" VerticalAlignment="Center"/>
						<Track x:Name="PART_Track">
							<Track.DecreaseRepeatButton>
								<RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
							</Track.DecreaseRepeatButton>
							<Track.Thumb>
								<Thumb Style="{StaticResource SliderThumb}"/>
							</Track.Thumb>
							<Track.IncreaseRepeatButton>
								<RepeatButton Style="{StaticResource SliderEmpty}" Command="Slider.IncreaseLarge"/>
							</Track.IncreaseRepeatButton>
						</Track>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="GlassMeter" TargetType="ProgressBar">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ProgressBar">
					<Grid Height="6">
						<Border x:Name="PART_Track" CornerRadius="3" Background="#26FFFFFF"/>
						<Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource GreenFill}"/>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
