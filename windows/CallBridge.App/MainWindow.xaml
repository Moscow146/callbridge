<Window x:Class="CallBridge.App.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:CallBridge.App"
		Title="CallBridge" Icon="Assets/app.ico" Width="420" Height="720" MinWidth="380" MinHeight="420"
		Background="{DynamicResource WindowBg}" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Label}"
		TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" PreviewKeyDown="OnWindowKey">
	<Window.Resources>
		<Style x:Key="SuggestionItem" TargetType="ListBoxItem">
			<EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnSuggestionClick"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border x:Name="Bd" CornerRadius="8" Margin="6,1" Padding="10,6" Background="Transparent">
							<ContentPresenter/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fill}"/>
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillPressed}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
	<ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
		<StackPanel Margin="20,82,20,14" MaxWidth="560">

			<Border x:Name="QrCard" Style="{StaticResource Section}">
				<StackPanel HorizontalAlignment="Center">
					<TextBlock Text="{local:L ScanTitle}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
					<TextBlock Text="{local:L ScanHint}" Foreground="{DynamicResource LabelSecondary}" FontSize="14"
							   TextWrapping="Wrap" TextAlignment="Center" Margin="8,4,8,16"/>
					<Border Background="White" CornerRadius="14" Padding="12" HorizontalAlignment="Center">
						<Image x:Name="QrImage" Width="180" Height="180" RenderOptions.BitmapScalingMode="NearestNeighbor"
							   AutomationProperties.Name="{local:L QrName}"/>
					</Border>
					<Button Content="{local:L NewCode}" Style="{StaticResource PushButton}" HorizontalAlignment="Center" Margin="0,16,0,0" Click="OnNewCode"/>
				</StackPanel>
			</Border>

			<Border x:Name="CallCard" Style="{StaticResource Section}" Visibility="Collapsed">
				<StackPanel>
					<Grid Width="64" Height="64" HorizontalAlignment="Center">
						<Ellipse Fill="{DynamicResource Fill}"/>
						<TextBlock x:Name="AvatarText" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LabelSecondary}"/>
						<TextBlock x:Name="AvatarGlyph" Style="{StaticResource IconGlyph}" Text="&#xE717;" FontSize="24" Foreground="{DynamicResource LabelSecondary}"/>
					</Grid>
					<TextBlock x:Name="CallTitle" Text="{local:L NoCall}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
							   AutomationProperties.LiveSetting="Assertive"/>
					<TextBlock x:Name="CallSub" Text="{local:L WaitingCall}" Foreground="{DynamicResource LabelSecondary}" FontSize="14" TextAlignment="Center" Margin="0,2,0,0"/>
					<TextBlock x:Name="RouteText" Foreground="{DynamicResource Red}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
							   AutomationProperties.LiveSetting="Polite"/>

					<StackPanel x:Name="RingingActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,2" Visibility="Collapsed">
						<Button x:Name="RejectButton" Style="{StaticResource CallAction}" Tag="&#xE778;" Content="{local:L Decline}" Background="{DynamicResource RedFill}" Foreground="{DynamicResource OnFill}"
								Width="84" Margin="0,0,28,0" Click="OnReject"/>
						<Button x:Name="AnswerButton" Style="{StaticResource CallAction}" Tag="&#xE717;" Content="{local:L Accept}" Background="{DynamicResource GreenFill}" Foreground="{DynamicResource OnFill}"
								Width="84" ToolTip="{local:L AcceptTip}" Click="OnAnswer"/>
					</StackPanel>

					<StackPanel x:Name="DialPanel" Margin="0,18,0,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBox x:Name="DialBox" Style="{StaticResource CallField}" Tag="{local:L NameOrNumber}" TextChanged="OnDialTextChanged"
									 AutomationProperties.Name="{local:L NameOrNumber}" PreviewKeyDown="OnDialKey" LostKeyboardFocus="OnDialLostFocus" GotKeyboardFocus="OnDialFocus"/>
							<Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=DialBox}" Placement="Bottom" AllowsTransparency="True"
								   StaysOpen="True" Focusable="False">
								<Border Width="{Binding ActualWidth, ElementName=DialBox}" Margin="0,4,0,24" CornerRadius="12" Background="{DynamicResource Raised}"
										BorderBrush="{DynamicResource Separator}" BorderThickness="1" Effect="{StaticResource PopupShadow}">
									<ListBox x:Name="SuggestionList" Background="Transparent" BorderThickness="0" Margin="0,5" Focusable="False"
											 ItemContainerStyle="{StaticResource SuggestionItem}">
										<ListBox.ItemTemplate>
											<DataTemplate>
												<StackPanel>
													<TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource Label}" TextTrimming="CharacterEllipsis"/>
													<TextBlock Text="{Binding Number}" FontSize="12" Foreground="{DynamicResource LabelSecondary}"/>
												</StackPanel>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
								</Border>
							</Popup>
							<Button x:Name="DialButton" Grid.Column="1" Margin="8,0,0,0" Width="36" Height="36" Padding="0" Style="{StaticResource PushButton}"
									Background="{DynamicResource GreenFill}" Foreground="{DynamicResource OnFill}" Click="OnDial" IsEnabled="False"
									AutomationProperties.Name="{local:L Call}" ToolTip="{local:L Call}">
								<TextBlock Style="{StaticResource IconGlyph}" Text="&#xE717;" FontSize="15"/>
							</Button>
						</Grid>
						<TextBlock x:Name="DialHint" Foreground="{DynamicResource Red}" FontSize="13" TextWrapping="Wrap" Margin="4,6,0,0" Visibility="Collapsed"
								   AutomationProperties.LiveSetting="Polite"/>
					</StackPanel>
				</StackPanel>
			</Border>

			<TextBlock Style="{StaticResource SectionHeader}" Text="{local:L Microphone}"/>
			<Border Style="{StaticResource Section}">
				<StackPanel>
					<ComboBox x:Name="MicCombo" Style="{StaticResource PopupButton}" SelectionChanged="OnDeviceChanged" AutomationProperties.Name="{local:L Microphone}"/>
					<ProgressBar x:Name="MicLevel" Style="{StaticResource LevelMeter}" Maximum="1" Margin="2,12,2,8" AutomationProperties.Name="{local:L MicMeter}"/>
					<Grid Margin="2,0,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock Style="{StaticResource Field}" Text="{local:L Gain}" Margin="0,0,12,0"/>
						<Slider x:Name="MicGainSlider" Grid.Column="1" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="3" Value="1" ValueChanged="OnMicGainChanged"
								AutomationProperties.Name="{local:L Gain}"/>
						<TextBlock x:Name="MicGainText" Grid.Column="2" Style="{StaticResource Value}" Text="100%"/>
					</Grid>
					<CheckBox x:Name="EchoCheck" Content="{local:L EchoCancel}" Foreground="{DynamicResource Label}" Margin="2,10,0,0"
							  Click="OnEchoClick" AutomationProperties.Name="{local:L EchoCancel}"/>
				</StackPanel>
			</Border>

			<TextBlock Style="{StaticResource SectionHeader}" Text="{local:L Output}"/>
			<Border Style="{StaticResource Section}">
				<StackPanel>
					<ComboBox x:Name="SpeakerCombo" Style="{StaticResource PopupButton}" SelectionChanged="OnDeviceChanged" AutomationProperties.Name="{local:L Output}"/>
					<Grid Margin="2,10,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock Style="{StaticResource Field}" Text="{local:L Volume}" Margin="0,0,12,0"/>
						<Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="2" Value="1" ValueChanged="OnVolumeChanged"
								AutomationProperties.Name="{local:L Volume}"/>
						<TextBlock x:Name="VolumeText" Grid.Column="2" Style="{StaticResource Value}" Text="100%"/>
					</Grid>
				</StackPanel>
			</Border>
			<TextBlock Style="{StaticResource SectionHeader}" Text="{local:L Startup}"/>
			<Border Style="{StaticResource Section}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBlock Style="{StaticResource Field}" Text="{local:L StartWithWindows}" TextWrapping="Wrap" Margin="0,0,12,0"/>
					<ToggleButton x:Name="AutostartSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" ToolTip="{local:L StartWithWindowsTip}"
								  AutomationProperties.Name="{local:L StartWithWindows}" Click="OnAutostartClick"/>
				</Grid>
			</Border>
			<Border Height="128" Visibility="{Binding Visibility, ElementName=CallActions}"/>
		</StackPanel>
	</ScrollViewer>
	<Grid x:Name="HeaderBar" Margin="20,12,20,0" MaxWidth="560" VerticalAlignment="Top" Effect="{DynamicResource GlassShadow}">
		<Grid x:Name="HeaderGlass" Visibility="{DynamicResource GlassBlur}" IsHitTestVisible="False">
			<Border Background="{DynamicResource WindowBg}"/>
			<Rectangle x:Name="HeaderBlur" Margin="-28" Opacity="{DynamicResource GlassBlurOpacity}">
				<Rectangle.Effect>
					<BlurEffect Radius="22" KernelType="Gaussian" RenderingBias="Performance"/>
				</Rectangle.Effect>
			</Rectangle>
		</Grid>
		<Border CornerRadius="28" Background="{DynamicResource GlassBar}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" MinHeight="56" Padding="24,0">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
				<Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Orange}" VerticalAlignment="Center"/>
				<TextBlock x:Name="StatusText" Text="{local:L WaitingPhone}" FontSize="13" Foreground="{DynamicResource Label}" Margin="8,0,0,0" VerticalAlignment="Center"
						   AutomationProperties.LiveSetting="Polite"/>
			</StackPanel>
		</Border>
		<Border CornerRadius="28" Background="{DynamicResource GlassSheen}" IsHitTestVisible="False"/>
	</Grid>
	<Grid x:Name="CallActions" Margin="20,0,20,14" MaxWidth="560" VerticalAlignment="Bottom" Visibility="Collapsed" Effect="{DynamicResource GlassShadow}">
		<Grid x:Name="ActionsGlass" Visibility="{DynamicResource GlassBlur}" IsHitTestVisible="False">
			<Border Background="{DynamicResource WindowBg}"/>
			<Rectangle x:Name="ActionsBlur" Margin="-28" Opacity="{DynamicResource GlassBlurOpacity}">
				<Rectangle.Effect>
					<BlurEffect Radius="22" KernelType="Gaussian" RenderingBias="Performance"/>
				</Rectangle.Effect>
			</Rectangle>
		</Grid>
		<Border CornerRadius="28" Background="{DynamicResource GlassBar}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" Padding="16,14,16,12">
			<UniformGrid Rows="1">
				<ToggleButton x:Name="MuteButton" Style="{StaticResource CallToggle}" Tag="&#xE720;" local:CallActionGlyph.Checked="&#xEC54;" Content="{local:L MuteMic}"
							  ToolTip="{local:L MuteTip}" Click="OnMuteClick"/>
				<ToggleButton x:Name="DeafenButton" Style="{StaticResource CallToggle}" Tag="&#xE767;" local:CallActionGlyph.Checked="&#xE74F;" Content="{local:L MuteSound}"
							  ToolTip="{local:L SoundTip}" Click="OnDeafenClick"/>
				<Button x:Name="ModeButton" Style="{StaticResource CallAction}" Tag="&#xE8AB;" Content="{local:L ToPhone}" Click="OnModeClick"/>
				<Button x:Name="HangupButton" Style="{StaticResource CallAction}" Tag="&#xE778;" Content="{local:L End}" Background="{DynamicResource RedFill}" Foreground="{DynamicResource OnFill}"
						ToolTip="{local:L EndTip}" Click="OnHangup"/>
			</UniformGrid>
		</Border>
		<Border CornerRadius="28" Background="{DynamicResource GlassSheen}" IsHitTestVisible="False"/>
	</Grid>
	</Grid>
</Window>
