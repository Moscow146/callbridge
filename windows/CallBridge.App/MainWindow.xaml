<Window x:Class="CallBridge.App.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:CallBridge.App"
		Title="CallBridge" Icon="Assets/app.ico" Width="440" Height="800" MinWidth="400" MinHeight="620"
		Background="#FF080B18" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimary}"
		TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
	<Window.Resources>
		<Style x:Key="GlassListItem" TargetType="ListBoxItem">
			<EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnSuggestionClick"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border x:Name="Bd" CornerRadius="14" Margin="6,2" Padding="14,8" Background="Transparent" Cursor="Hand">
							<ContentPresenter/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#47FFFFFF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Window.Triggers>
		<EventTrigger RoutedEvent="FrameworkElement.Loaded">
			<BeginStoryboard>
				<Storyboard RepeatBehavior="Forever" AutoReverse="True">
					<DoubleAnimation Storyboard.TargetName="BlueShift" Storyboard.TargetProperty="X" From="-60" To="120" Duration="0:0:14">
						<DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
					</DoubleAnimation>
					<DoubleAnimation Storyboard.TargetName="BlueShift" Storyboard.TargetProperty="Y" From="-40" To="160" Duration="0:0:17">
						<DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
					</DoubleAnimation>
					<DoubleAnimation Storyboard.TargetName="PinkShift" Storyboard.TargetProperty="X" From="80" To="-120" Duration="0:0:19">
						<DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
					</DoubleAnimation>
					<DoubleAnimation Storyboard.TargetName="PinkShift" Storyboard.TargetProperty="Y" From="60" To="-140" Duration="0:0:15">
						<DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
					</DoubleAnimation>
					<DoubleAnimation Storyboard.TargetName="TealShift" Storyboard.TargetProperty="X" From="-90" To="100" Duration="0:0:21">
						<DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
					</DoubleAnimation>
					<DoubleAnimation Storyboard.TargetName="TealShift" Storyboard.TargetProperty="Y" From="100" To="-80" Duration="0:0:18">
						<DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
					</DoubleAnimation>
				</Storyboard>
			</BeginStoryboard>
		</EventTrigger>
	</Window.Triggers>

	<Grid ClipToBounds="True">
		<Grid.Background>
			<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
				<GradientStop Color="#FF0A1030" Offset="0"/>
				<GradientStop Color="#FF150B2E" Offset="0.6"/>
				<GradientStop Color="#FF0B1A2E" Offset="1"/>
			</LinearGradientBrush>
		</Grid.Background>

		<Canvas IsHitTestVisible="False">
			<Ellipse Width="420" Height="420" Canvas.Left="-140" Canvas.Top="-100" Fill="#CC3B82F6">
				<Ellipse.RenderTransform><TranslateTransform x:Name="BlueShift"/></Ellipse.RenderTransform>
				<Ellipse.Effect><BlurEffect Radius="120" KernelType="Gaussian"/></Ellipse.Effect>
			</Ellipse>
			<Ellipse Width="380" Height="380" Canvas.Left="200" Canvas.Top="260" Fill="#B3EC4899">
				<Ellipse.RenderTransform><TranslateTransform x:Name="PinkShift"/></Ellipse.RenderTransform>
				<Ellipse.Effect><BlurEffect Radius="120" KernelType="Gaussian"/></Ellipse.Effect>
			</Ellipse>
			<Ellipse Width="340" Height="340" Canvas.Left="-80" Canvas.Top="480" Fill="#9914B8A6">
				<Ellipse.RenderTransform><TranslateTransform x:Name="TealShift"/></Ellipse.RenderTransform>
				<Ellipse.Effect><BlurEffect Radius="120" KernelType="Gaussian"/></Ellipse.Effect>
			</Ellipse>
		</Canvas>

		<ScrollViewer VerticalScrollBarVisibility="Hidden">
			<StackPanel Margin="22,18,22,12">
				<Grid Margin="4,4,4,18">
					<TextBlock Text="CallBridge" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
					<Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Pill}}" Padding="12,7" Background="#26FFFFFF"
							BorderBrush="{StaticResource GlassRim}" BorderThickness="1">
						<StackPanel Orientation="Horizontal">
							<Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Amber}" VerticalAlignment="Center"/>
							<TextBlock x:Name="StatusText" Text="{local:L WaitingPhone}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
						</StackPanel>
					</Border>
				</Grid>

				<Border x:Name="QrCard" Style="{StaticResource Card}">
					<StackPanel HorizontalAlignment="Center">
						<Border Background="White" CornerRadius="26" Padding="14" HorizontalAlignment="Center" Effect="{StaticResource SoftShadow}">
							<Image x:Name="QrImage" Width="190" Height="190" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
						</Border>
						<TextBlock Text="{local:L ScanHint}" Foreground="{StaticResource TextSecondary}"
								   TextWrapping="Wrap" TextAlignment="Center" Margin="12,16,12,14" FontSize="13"/>
						<Button Content="{local:L NewCode}" Style="{StaticResource GlassButton}" HorizontalAlignment="Center" Click="OnNewCode"/>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource Card}">
					<StackPanel>
						<TextBlock x:Name="CallTitle" Text="{local:L NoCall}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
						<TextBlock x:Name="CallSub" Text="{local:L WaitingCall}" Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,2,0,0"/>
						<TextBlock x:Name="RouteText" Foreground="{StaticResource Red}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
							<Button x:Name="AnswerButton" Style="{StaticResource RoundButton}" Background="{StaticResource GreenFill}" Margin="0,0,22,0"
									Click="OnAnswer" Visibility="Collapsed">
								<TextBlock Style="{StaticResource IconText}" Text="&#xE717;"/>
							</Button>
							<Button x:Name="RejectButton" Style="{StaticResource RoundButton}" Background="{StaticResource RedFill}"
									Click="OnReject" Visibility="Collapsed">
								<TextBlock Style="{StaticResource IconText}" Text="&#xE717;" RenderTransformOrigin="0.5,0.5">
									<TextBlock.RenderTransform><RotateTransform Angle="135"/></TextBlock.RenderTransform>
								</TextBlock>
							</Button>
							<Button x:Name="HangupButton" Style="{StaticResource RoundButton}" Background="{StaticResource RedFill}"
									Click="OnHangup" Visibility="Collapsed">
								<TextBlock Style="{StaticResource IconText}" Text="&#xE717;" RenderTransformOrigin="0.5,0.5">
									<TextBlock.RenderTransform><RotateTransform Angle="135"/></TextBlock.RenderTransform>
								</TextBlock>
							</Button>
						</StackPanel>
						<Grid Margin="0,18,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBox x:Name="DialBox" Style="{StaticResource GlassTextBox}" Tag="{local:L NameOrNumber}" TextChanged="OnDialTextChanged"
									 PreviewKeyDown="OnDialKey" LostKeyboardFocus="OnDialLostFocus"/>
							<Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=DialBox}" Placement="Bottom" AllowsTransparency="True"
								   StaysOpen="True" Focusable="False" PopupAnimation="Fade">
								<Border Width="{Binding ActualWidth, ElementName=DialBox}" Margin="0,6,0,24" CornerRadius="22" Background="#F2161B30"
										BorderBrush="{StaticResource GlassRim}" BorderThickness="1" Effect="{StaticResource CardShadow}">
									<ListBox x:Name="SuggestionList" Background="Transparent" BorderThickness="0" Margin="0,8" Focusable="False"
											 ItemContainerStyle="{StaticResource GlassListItem}">
										<ListBox.ItemTemplate>
											<DataTemplate>
												<StackPanel>
													<TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
													<TextBlock Text="{Binding Number}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
												</StackPanel>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
								</Border>
							</Popup>
							<Button x:Name="DialButton" Grid.Column="1" Margin="10,0,0,0" Width="44" Height="44" Padding="0" Style="{StaticResource GlassButton}"
									Background="{StaticResource GreenFill}" Click="OnDial" IsEnabled="False">
								<TextBlock Style="{StaticResource IconText}" Text="&#xE717;" FontSize="16"/>
							</Button>
						</Grid>
						<TextBlock x:Name="DialHint" Foreground="{StaticResource Red}" FontSize="12" Margin="6,8,0,0" Visibility="Collapsed"/>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource Card}">
					<StackPanel>
						<TextBlock Style="{StaticResource Caption}" Text="{local:L Microphone}"/>
						<ComboBox x:Name="MicCombo" Style="{StaticResource GlassCombo}" SelectionChanged="OnDeviceChanged"/>
						<ProgressBar x:Name="MicLevel" Style="{StaticResource GlassMeter}" Maximum="1" Margin="8,10,8,6"/>
						<Grid Margin="4,4,4,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Style="{StaticResource IconText}" Text="&#xE720;" FontSize="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/>
							<Slider x:Name="MicGainSlider" Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="3" Value="1" ValueChanged="OnMicGainChanged"/>
							<TextBlock x:Name="MicGainText" Grid.Column="2" Text="100%" Foreground="{StaticResource TextSecondary}" FontSize="12" Width="42" TextAlignment="Right" VerticalAlignment="Center"/>
						</Grid>

						<TextBlock Style="{StaticResource Caption}" Text="{local:L Output}"/>
						<ComboBox x:Name="SpeakerCombo" Style="{StaticResource GlassCombo}" SelectionChanged="OnDeviceChanged"/>

						<Grid Margin="4,18,4,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Style="{StaticResource IconText}" Text="&#xE767;" FontSize="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/>
							<Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="2" Value="1" ValueChanged="OnVolumeChanged"/>
							<TextBlock x:Name="VolumeText" Grid.Column="2" Text="100%" Foreground="{StaticResource TextSecondary}" FontSize="12" Width="42" TextAlignment="Right" VerticalAlignment="Center"/>
						</Grid>

						<UniformGrid Columns="2" Margin="0,20,0,0">
							<ToggleButton x:Name="MuteButton" Style="{StaticResource GlassToggle}" Margin="0,0,6,0" Click="OnMuteClick">
								<StackPanel Orientation="Horizontal">
									<TextBlock Style="{StaticResource IconText}" Text="&#xE720;" FontSize="16" Margin="0,0,8,0"/>
									<TextBlock Text="{local:L MuteMic}"/>
								</StackPanel>
							</ToggleButton>
							<ToggleButton x:Name="DeafenButton" Style="{StaticResource GlassToggle}" Margin="6,0,0,0" Click="OnDeafenClick">
								<StackPanel Orientation="Horizontal">
									<TextBlock Style="{StaticResource IconText}" Text="&#xE74F;" FontSize="16" Margin="0,0,8,0"/>
									<TextBlock Text="{local:L MuteSound}"/>
								</StackPanel>
							</ToggleButton>
						</UniformGrid>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>
